{
    "name": "ziyuan-zhang-website",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b",
        "format": "prettier --write .",
        "lint": "eslint .",
        "lint:design": "npx -y @google/design.md lint DESIGN.md",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@fontsource/instrument-serif": "^5.3.0",
        "@phosphor-icons/react": "^2.1.10",
        "@tailwindcss/vite": "^4.3.3",
        "@untitledui/icons": "^0.0.23",
        "react": "^19.3.0",
        "react-aria": "^3.52.1",
        "react-aria-components": "^1.21.1",
        "react-dom": "^19.3.0",
        "react-router": "^8.4.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.2.0",
        "use-intl": "^4.15.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.13",
        "@playwright/test": "1.65",
        "@rolldown/plugin-babel": "^0.3.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^5.1.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.1",
        "vitest": "^5.1.0"
    }
}
